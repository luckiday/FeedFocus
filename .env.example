# Feed Focus for YouTube — copy to `.env` beside manifest.json (gitignored). Used for:
# - esbuild: keys are inlined into the background bundle when you run `npm run build`
# - runtime: optional merge into chrome.storage on install (model / batch / verbose)

# Aliyun DashScope (OpenAI-compatible): https://help.aliyun.com/zh/model-studio/
DASHSCOPE_API_KEY=
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Volcengine Ark (doubao / ep- models)
ARK_API_KEY=
