{
  "manifest_version": 3,
  "name": "Feed Focus for YouTube",
  "version": "1.0.0",
  "description": "Attention cues on YouTube home: green/yellow/red tile markers (bring your own LLM API key) plus offline gray hints—not medical advice.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://ark.cn-beijing.volces.com/*",
    "https://dashscope.aliyuncs.com/*",
    "https://*.workers.dev/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Feed Focus for YouTube",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content/youtube-home.js"],
      "css": ["content/youtube-home.css"],
      "run_at": "document_idle"
    }
  ]
}
